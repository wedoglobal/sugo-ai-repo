{
  "manifest_version": 3,
  "name": "Velora AI",
  "version": "0.2.1",
  "description": "Velora AI: sohbet otomasyonu, site bazlı GPS ve IPv4 proxy yönetimi.",
  "permissions": [
    "storage",
    "debugger",
    "proxy",
    "tabs",
    "webRequest",
    "webRequestAuthProvider",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sugo.live/*",
        "https://www.sugo.live/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sugo.live/*",
        "https://www.sugo.live/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://sugo-host.b-erdincozer.workers.dev/*"
      ],
      "js": [
        "network-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Velora AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "minimum_chrome_version": "108",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
