{
  "name": "sugo-host",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    "run_worker_first": [
      "/downloads/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://amhthbxfdnhsicntspex.supabase.co"
  }
}
