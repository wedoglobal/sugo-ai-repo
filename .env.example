# Supabase — lokal: `supabase status -o env`; cloud: Project Settings > API
SUPABASE_URL=http://127.0.0.1:55321
# Sadece sunucuda kullanılır (service_role / secret key). Asla istemciye veya extension'a verme.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too
EXTENSION_API_KEY=change-me-ext
# Deploy'da dashboard'un public URL'i (adapter-node, form CSRF kontrolü için gerekli), ör. https://host.example.com
ORIGIN=

# LLM (OpenRouter)
OPENROUTER_API_KEY=
SUGO_MODEL_CHAT=x-ai/grok-4.7
SUGO_MODEL_EXTRACT=google/gemini-2.5-flash
